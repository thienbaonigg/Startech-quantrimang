# Backend environment (copy to .env.production on production server)
# Chatbot AI: local Ollama model (data stays inside internal network)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=30000
# RAG settings
RAG_TOP_K=3
SIMILARITY_THRESHOLD=0.55
# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Rate limiting (anti-abuse)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
# Allowed origins (CORS)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://192.168.10.12,http://startech.local